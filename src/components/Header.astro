---
import { buttonVariants } from "../components/ui/button";
import { ModeToggle } from "../components/react/ThemeToggle";
import { PROFILE } from "../content/profileData";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLanguage, getUI, localizePath } from "../i18n/utils";

const language = getLanguage(Astro.url);
const t = getUI(language);
---

<header
  class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <div
    class="container flex min-h-16 flex-wrap items-center justify-between gap-x-2 gap-y-1 px-2 py-2 sm:px-4"
  >
    <div class="flex gap-6 md:gap-10">
      <a data-home-link href={localizePath("/", language)} class="flex items-center space-x-2">
        <span class="inline-block font-bold">{PROFILE.name}</span>
      </a>
    </div>
    <div class="flex flex-1 items-center justify-end space-x-4">
      <nav aria-label={t.navigation} class="flex items-center gap-1">
        <a href={localizePath("/projects", language)} class={buttonVariants({ variant: "ghost", className: "px-2 sm:px-4" })}>
          {t.projects}
        </a>

        <a href={localizePath("/posts", language)} class={buttonVariants({ variant: "ghost", className: "px-2 sm:px-4" })}>
          {t.blog}
        </a>
        <!--
        <a
          href={PROFILE.repo}
          target="_blank"
          rel="noreferrer"
          class={buttonVariants({variant: 'ghost'})}
        >
          GitHub
        </a>
        -->

        <LanguageSwitcher />
        <ModeToggle label={t.theme} client:load />
      </nav>
    </div>
  </div>
</header>

<script>
  function restoreTheme() {
    try {
      const theme = localStorage.getItem("theme");
      const dark = theme ? theme === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
    } catch {}
  }
  document.addEventListener("astro:after-swap", restoreTheme);
  restoreTheme();
</script>
