---
import Card from "../Card.astro";
import { getLanguage, getUI } from "../../i18n/utils";
const t = getUI(getLanguage(Astro.url));

const { words = [] } = Astro.props;
const safeWords = Array.isArray(words) ? words : [];
---

<Card>
  <div data-quotes={JSON.stringify(safeWords)} class="flex h-full flex-col justify-between gap-3">
    <div class="flex items-start justify-between gap-3">
      <blockquote
        class="mt-6 flex-1 border-l-2 pl-6 italic"
        data-quote
      >
        “{safeWords[0] ?? ""}”
      </blockquote>

      <div class="mt-6 flex shrink-0 items-center gap-1">
        <button
          type="button"
          data-prev
          aria-label={t.previousQuote}
          class="rounded-md p-2 text-neutral-300 hover:bg-neutral-800 hover:text-neutral-50 focus:outline-none focus:ring-2 focus:ring-neutral-500 disabled:opacity-40"
        >
          <!-- Flecha izquierda -->
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>

        <button
          type="button"
          data-next
          aria-label={t.nextQuote}
          class="rounded-md p-2 text-neutral-300 hover:bg-neutral-800 hover:text-neutral-50 focus:outline-none focus:ring-2 focus:ring-neutral-500 disabled:opacity-40"
        >
          <!-- Flecha derecha -->
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>

    <p class="pl-6 text-xs text-neutral-400" data-meta></p>
  </div>

  <script>
  function initializeQuotes() {
    document.querySelectorAll<HTMLElement>("[data-quotes]").forEach((root) => {
      if (root.dataset.initialized) return;
      const words: string[] = JSON.parse(root.dataset.quotes ?? "[]");
      const quoteEl = root.querySelector("[data-quote]");
      const metaEl = root.querySelector("[data-meta]");
      const prevBtn = root.querySelector<HTMLButtonElement>("[data-prev]");
      const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]");
      if (!quoteEl || !words.length) return;
      root.dataset.initialized = "true";
      let index = 0;
      try { index = Number(localStorage.getItem("quoteIndex") ?? 0); } catch {}
      if (!Number.isInteger(index) || index < 0 || index >= words.length) index = 0;
      const render = () => {
        quoteEl.textContent = "“" + words[index] + "”";
        if (metaEl) metaEl.textContent = (index + 1) + " / " + words.length;
        try { localStorage.setItem("quoteIndex", String(index)); } catch {}
        if (prevBtn) prevBtn.disabled = words.length <= 1;
        if (nextBtn) nextBtn.disabled = words.length <= 1;
      };
      prevBtn?.addEventListener("click", () => { index = (index - 1 + words.length) % words.length; render(); });
      nextBtn?.addEventListener("click", () => { index = (index + 1) % words.length; render(); });
      render();
    });
  }
  document.addEventListener("astro:page-load", initializeQuotes);
  initializeQuotes();
</script>
</Card>
