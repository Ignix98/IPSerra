---
import { getTagGroups } from "../../i18n/content";
import { getTagPath } from "../../i18n/tags";
import { getProfile } from "../../content/profileData";
import { getLanguage, getUI, localizePath } from "../../i18n/utils";
const language = getLanguage(Astro.url);
const t = getUI(language);
const PROFILE = getProfile(language);

const tagsMap = await getTagGroups(language);

const skills = PROFILE.skills;
---

<div class="flex flex-col gap-2 animate-appear">
  <p class="text-sm font-light mb-1">
    {PROFILE.headLine}
  </p>

  <p class="text-md mb-1 font-medium text-justify">
    {PROFILE.headLine2}
  </p>

  <hr />

  <p class="text-sm font-light">{t.technologies}</p>
  <ul class="list-outside list-disc pl-8">
    {
      skills.map((skill) => {
        if (tagsMap.has(skill)) {
          return (
            <li>
              <a href={getTagPath(skill, language)} class="hover:font-bold">
                {skill}
              </a>
            </li>
          );
        } else {
          return (
            <li>
              <span>{skill}</span>
            </li>
          );
        }
      })
    }
  </ul>

  <p class="text-sm font-light">
    {t.moreAbout} <a href={localizePath("/projects", language)} class="underline hover:font-bold"
      >{t.projects}</a
    > {t.andMy} <a href={localizePath("/experiences", language)} class="underline hover:font-bold"
      >{t.experience}</a
    >.
  </p>
</div>
