---
import { getLocalizedCollection, getEntryPath } from "../../i18n/content";
import { getLanguage, getUI, localizePath, locales } from "../../i18n/utils";
const language = getLanguage(Astro.url);
const t = getUI(language);
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { formateLocalDate } from "../../lib/utils";


let posts = await getLocalizedCollection("posts", language);

posts = posts.sort((a, b) => {
  return b.data.startDate.getTime() - a.data.startDate.getTime();
});
posts = posts.slice(0, 2);
---


<div class="mt-2 space-y-4">
  {
    posts.map((project) => (
      <div>
        <h3 class="text-lg font-semibold text-primary">
          <a href={getEntryPath(project)} class="hover:underline line-clamp-2">
            {project.data.title}
          </a>
        </h3>
        <p class="text-sm line-clamp-2">
          {project.data.description}
        </p>
        <p class="text-sm text-gray-600">
          {formateLocalDate(project.data.startDate, undefined, locales[language])}
        </p>
      </div>
    ))
  }
  <a href={localizePath("/posts", language)}>
    <Button variant="link" className="pl-0">{t.more}</Button>
  </a>
</div>

