---
import { getLocalizedCollection, getEntryPath } from "../../i18n/content";
import { Button } from "../ui/button";
import { formateLocalDate } from "../../lib/utils";
import { ArrowRight } from "lucide-react";
import { getLanguage, getUI, locales, localizePath } from "../../i18n/utils";

const language = getLanguage(Astro.url);
const t = getUI(language);

let projects = await getLocalizedCollection("projects", language);

projects.sort((a: any, b: any) => {
  return new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime();
});

projects = projects.slice(0, 3);
---

<div class="mt-2 flex flex-col gap-3">
  {
    projects.map((project) => {
      const href = getEntryPath(project);

      return (
        <a
          href={href}
          class="block w-full rounded-lg border p-4 transition-colors hover:bg-muted/30 hover:border-foreground/20"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="text-base font-semibold leading-tight text-primary">
                {project.data.title}
              </p>

              <p class="mt-1 text-sm text-muted-foreground">
                {project.data.summary}
              </p>

              <p class="mt-2 text-sm text-muted-foreground">
                {formateLocalDate(project.data.startDate, undefined, locales[language])}
              </p>
            </div>

            <ArrowRight className="shrink-0 opacity-70" />
          </div>
        </a>
      );
    })
  }

  <a href={localizePath("/projects", language)}>
    <Button variant="link" className="pl-0">{t.more}</Button>
  </a>
</div>
