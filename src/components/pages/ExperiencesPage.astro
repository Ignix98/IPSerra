---
import { getLocalizedCollection, getEntryPath } from "../../i18n/content";
import { getLanguage, getUI, locales } from "../../i18n/utils";
import { translateTag } from "../../i18n/tags";
const language = getLanguage(Astro.url);
const t = getUI(language);
import { formateLocalDate, formateLocalMonth } from "../../lib/utils";
import { Badge } from "../../components/ui/badge";
import IndexPageLayout from "../../layouts/IndexPageLayout.astro";
import { TableCell, TableRow, Table, TableHeader, TableHead, TableBody } from "../../components/ui/table";
import { ArrowRight } from "lucide-react";

const experiences = await getLocalizedCollection("experiences", language);

experiences.sort((a, b) => {
  return b.data.startDate.getTime() - a.data.startDate.getTime();
});
---

<IndexPageLayout
  title={t.experiences}
  description={t.experiencesDescription}
  subTitle={t.experiencesTitle}
>
  <Table>
    <!--<TableHeader>-->
    <!--    &lt;!&ndash;<TableRow>&ndash;&gt;-->
    <!--    &lt;!&ndash;</TableRow>&ndash;&gt;-->
    <!--  </TableHeader>-->
    <TableBody>
      {
        experiences.map((entry) => (
          <TableRow key={entry.id}>
            <TableCell className="font-medium ">
              <div class="flex flex-col gap-1 min-w-20">
                <a
                  href={getEntryPath(entry)}
                  class={`font-semibold hover:font-extrabold ${entry?.id ? 'text-primary' : 'text-foreground'}`}
                >
                  {entry.data.title}
                </a>

                <div class="mb-4 text-sm">
                  {formateLocalMonth(entry.data.startDate, undefined, locales[language])} - {entry.data.endDate ? formateLocalMonth(entry.data.endDate, undefined, locales[language]) : t.present}
                </div>
              </div>
            </TableCell>

            <TableCell>
              <div class="ml-4 flex p-2 flex-col gap-2 text-sm max-w-lg min-w-16">
                {entry.data.company}

                <div class="flex flex-0 gap-1 flex-wrap">
                  {entry.data.tags?.map((i) => (
                    <span>
                      <Badge className="truncate cursor-default">{translateTag(i, language)}</Badge>
                    </span>
                  ))}
                </div>
              </div>
            </TableCell>

            <TableCell>
              <a href={getEntryPath(entry)} aria-label={t.more + ": " + entry.data.title}>
                <ArrowRight />
              </a>
            </TableCell>
          </TableRow>
        ))
      }
    </TableBody>
  </Table>
</IndexPageLayout>

