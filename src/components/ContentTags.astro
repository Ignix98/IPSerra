---
import { Badge } from "./ui/badge";
import { getLanguage } from "../i18n/utils";
import { translateTag } from "../i18n/tags";
const language = getLanguage(Astro.url);
const { tags = [] } = Astro.props;
---

<div class="flex flex-wrap gap-1">
  {tags.map((i) => (
    <span>
      <Badge
        className="truncate cursor-default select-none bg-primary text-primary-foreground !hover:bg-primary hover:ring-1 hover:ring-foreground/20"
      >
        {translateTag(i, language)}
      </Badge>
    </span>
  ))}
</div>

