---
import { ClientRouter } from 'astro:transitions'
import HeadSEO from '../components/HeadSEO.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { getLanguage } from '../i18n/utils'

interface Props {
  noindex?: boolean
  title?: string
  description?: string
  ogImage?: URL
  canonicalURL?: URL
}

const { title, description, ogImage, canonicalURL, noindex = false } = Astro.props
---

<html lang={getLanguage(Astro.url)}>
  <head>
    <HeadSEO noindex={noindex} title={title} description={description} ogImage={ogImage} canonicalURL={canonicalURL} />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased min-w-sm">
    <div class="flex flex-col items-center justify-center">
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>
